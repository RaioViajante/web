{
  "name": "@raioviajante/web",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format:check": "pnpm -r --if-present format:check",
    "security:origins": "node security/verify-origins.mjs",
    "seo:check": "node --test seo/*.test.mjs",
    "browser:check": "playwright test --config e2e/playwright.config.ts",
    "audit:check": "node security/audit-check.mjs",
    "perf:check": "node perf/check.mjs",
    "perf:lighthouse": "node --test perf/*.test.mjs && node perf/check-lighthouse.mjs",
    "links:check": "node --test links/*.test.mjs && node links/check.mjs",
    "commits:check": "node commits/check.mjs",
    "commits:test": "node --test commits/*.test.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "hooks:uninstall": "git config --unset core.hooksPath",
    "links:external": "node links/check.mjs --external",
    "seo:verify": "node seo/verify-metadata.mjs",
    "security:check": "node --test security/*.test.mjs && node security/sync-vercel.mjs --check",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm security:check && pnpm seo:check && pnpm commits:test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@playwright/test": "1.63.0",
    "lighthouse": "13.5.0"
  }
}
