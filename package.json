{
  "name": "@raioviajante/web",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format:check": "pnpm -r --if-present format:check",
    "security:origins": "node security/verify-origins.mjs",
    "seo:check": "node --test seo/*.test.mjs",
    "seo:verify": "node seo/verify-metadata.mjs",
    "security:check": "node --test security/*.test.mjs && node security/sync-vercel.mjs --check",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm security:check && pnpm seo:check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0"
  }
}
