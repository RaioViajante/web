---
import { isNotFoundPath } from "@raioviajante/design/seo";
import { SeoHead } from "@raioviajante/design/seo-head";
import { jsonLdScript } from "@raioviajante/design/seo";
import { themeColor } from "@raioviajante/design/theme-color";
import fontUrl from "@raioviajante/design/fonts/NotoSansMono-Latin-Variable.woff2?url";
import "@raioviajante/design/fonts.css";
import "@raioviajante/design/styles.css";
import "../styles/docs.css";
import type { NavItem } from "@raioviajante/design/shell";
import { DocsFrame } from "../components/DocsFrame";
import { navItems, searchNumber } from "../lib/docs";

interface Props {
	title: string;
	description: string;
	/** The page's path; the home page is "/". */
	current?: string;
	/** "On this page" list of a documentation page. */
	toc?: NavItem[];
	/** The home page uses its own, full-site title. */
	fullTitle?: boolean;
	/** Structured data nodes for this page. */
	jsonLd?: object[];
}

const { title, description, current, toc, fullTitle = false, jsonLd } = Astro.props;
const color = await themeColor();
const pageTitle = fullTitle ? title : `${title} — docs`;
const items = await navItems();
const number = await searchNumber();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
		<SeoHead
			origin={Astro.site!.href}
			site="docs"
			path={Astro.url.pathname}
			title={pageTitle}
			description={description}
			noindex={isNotFoundPath(Astro.url.pathname)}
			themeColor={color}
		/>
		{jsonLd && <script is:inline type="application/ld+json" set:html={jsonLdScript(...jsonLd)} />}
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.ico?v=4" sizes="any" />
		<link rel="icon" type="image/png" sizes="512x512" href="/icon.png?v=4" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=4" />
		<link rel="manifest" href="/manifest.webmanifest" />
	</head>
	<body>
		<DocsFrame pages={items} current={current} toc={toc} searchNumber={number}>
			<slot />
		</DocsFrame>
		<script>
			import { startBehavior } from "@raioviajante/design/behavior";
			startBehavior();
		</script>
	</body>
</html>
