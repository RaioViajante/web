---
// The RaioViajante brand mark. The whole "raioviajante ~ / docs" identity is a
// single link back to this site's own homepage (not the ecosystem root at
// raioviajante.com) — inside docs.raioviajante.com, "docs" is the current
// application, so its home link stays internal.
---

<a class="site-title sl-flex" href="/">
	<span class="brand">raioviajante</span><span class="tilde">&nbsp;~</span><span
		class="sep"
	>&nbsp;/&nbsp;</span><span class="current">docs</span>
</a>

<style>
	@layer starlight.core {
		.site-title {
			align-items: center;
			gap: 0;
			font-size: var(--sl-text-base);
			font-weight: 400;
			white-space: nowrap;
			min-width: 0;
			color: var(--sl-color-white);
			text-decoration: none;
		}
		.site-title:hover .brand {
			color: var(--rv-accent);
		}
		.tilde {
			color: var(--rv-accent);
		}
		.sep {
			color: color-mix(in srgb, var(--rv-fg) 45%, transparent);
		}
		.current {
			color: var(--sl-color-white);
		}
	}
</style>
