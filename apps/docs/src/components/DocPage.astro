---
import { render } from "astro:content";
import { Pager, Prose } from "@raioviajante/design/parts";
import { getSectionHeadings } from "@raioviajante/design/sections";
import { DocHeader } from "./DocHeader";
import DocsShell from "../layouts/DocsShell.astro";
import { pageJsonLd } from "../lib/structured-data";
import { formatDocDate } from "../lib/date";
import { counterpartOf, editUrl, getPages, homePath, labelOf, lastUpdated, navPages, pathOf, type DocEntry } from "../lib/docs";
import { breadcrumb } from "../lib/nav";
import { copyFor } from "../lib/copy";

const { entry, index } = Astro.props as { entry: DocEntry; index: number };
const locale = entry.data.locale;
const copy = copyFor(locale);
const { Content, remarkPluginFrontmatter } = await render(entry);
const headings = getSectionHeadings(remarkPluginFrontmatter);
const pages = await getPages(locale);
const { data } = entry;
const path = pathOf(entry);

const toc = headings
	.filter((heading) => heading.number !== undefined)
	.map((heading) => ({
		label: heading.text,
		href: `#${heading.slug}`,
		number: heading.number,
	}));

const crumbs = breadcrumb(await navPages(locale), index, copy.groupLabels[data.group]);
const updatedIso = lastUpdated(entry);
const updated = updatedIso ? { iso: updatedIso, text: formatDocDate(updatedIso, locale) } : undefined;
const jsonLd = await pageJsonLd(entry);
const counterpart = await counterpartOf(entry);

const neighbor = (page: (typeof pages)[number] | undefined, label: string) =>
	page ? { label, title: labelOf(page), href: pathOf(page) } : undefined;
const previous = index === 0 ? { label: copy.previous, title: copy.index, href: homePath(locale) } : neighbor(pages[index - 1], copy.previous);
const next = neighbor(pages[index + 1], copy.next);
---

<DocsShell title={data.title} description={data.description} current={path} toc={toc} jsonLd={jsonLd} locale={locale} counterparts={counterpart ? [{ locale: counterpart.data.locale, path: pathOf(counterpart) }] : undefined}>
	<DocHeader
		locale={locale}
		crumbs={crumbs}
		title={data.title}
		line={data.tagline ?? data.description}
		status={data.status}
		meta={data.meta}
		updated={updated}
		source={data.source}
	/>

	<Prose><Content /></Prose>

	<div class="page-foot">
		{updated && <span>{copy.lastUpdated} <time datetime={updated.iso}>{updated.text}</time></span>}
		<a href={editUrl(entry)}>{copy.edit} ↗</a>
	</div>
	<Pager locale={locale} prev={previous} next={next} />
</DocsShell>
