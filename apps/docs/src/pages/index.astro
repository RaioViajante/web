---
import { LeaderRow, Section } from "@raioviajante/design/parts";
import { DocsIndexHeader } from "../components/DocsIndexHeader";
import DocsShell from "../layouts/DocsShell.astro";
import { getPages, navPages, pathOf } from "../lib/docs";
import { childIndexes } from "../lib/nav";
import { homeJsonLd } from "../lib/structured-data";

const all = await getPages();
const nav = await navPages();
// A project's guide is followed by the pages listed under it (the Sweep CLI
// reference): the note names them, so a guide without any shows no note.
const notes = new Map(
	all.map((entry, index) => {
		const children = childIndexes(nav, index).map((child) => nav[child]!.label);
		return [entry.id, children.length ? ["guide", ...children].join(" · ") : undefined];
	}),
);
const pages = all.filter((entry) => !entry.data.sub);
const guides = pages.filter((entry) => entry.data.group === "projects");
const standards = pages.filter((entry) => entry.data.group === "raioviajante");
---

<DocsShell
	title="docs — technical documentation for things built under raioviajante."
	description="Public technical documentation for projects and systems built under RaioViajante."
	current="/"
	fullTitle
	jsonLd={homeJsonLd()}
>
	<DocsIndexHeader />

	<Section number="01." title="projects/" index>
		{
			guides.map((entry) => (
				<div class="docs-entry">
					<LeaderRow label={entry.data.title.toLowerCase()} value={entry.data.status} href={pathOf(entry)} />
					<p>{entry.data.summary}</p>
					{notes.get(entry.id) && <p class="docs-entry__note">{notes.get(entry.id)}</p>}
				</div>
			))
		}
		<div class="docs-entry">
			<LeaderRow label="hum" value="exploring" href="https://github.com/RaioViajante/hum" />
			<p>terminal music player</p>
		</div>
		<div class="docs-entry">
			<LeaderRow
				label="orbit"
				value="not documented yet"
				href="https://dump.raioviajante.com/posts/building-orbit"
			/>
			<p>self-hosted job scheduler</p>
			<p class="docs-entry__note">read about it on dump ↗</p>
		</div>
		<div class="docs-entry">
			<LeaderRow
				label="yanawa"
				value="not documented yet"
				href="https://dump.raioviajante.com/posts/started-designing-a-language-before-i-could-compile-one"
			/>
			<p>programming language in design</p>
			<p class="docs-entry__note">read about it on dump ↗</p>
		</div>
	</Section>

	<Section number="02." title="raioviajante/" index>
		{
			standards.map((entry) => (
				<div class="docs-entry">
					<LeaderRow label={entry.data.title.toLowerCase()} value={entry.data.status} href={pathOf(entry)} />
					<p>{entry.data.summary}</p>
				</div>
			))
		}
	</Section>
</DocsShell>
