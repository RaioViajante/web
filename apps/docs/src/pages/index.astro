---
// The homepage is a bespoke layout (not an article), built with StarlightPage so it
// still shares Head/Header/Footer/ThemeProvider with the rest of the site.
// `hero: {}` makes Page.astro skip the default PageTitle heading in favor of this
// slot content; the Hero component override renders nothing, since this site never
// uses Starlight's marketing-hero pattern.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Icon } from '@astrojs/starlight/components';
---

<StarlightPage
	frontmatter={{
		// dump's homepage title is its framework's "default" title — the site
		// name plus its tagline, e.g. "dump — a memory dump, hopefully
		// readable." (app/layout.tsx) — rather than the per-page
		// "page title — site name" template every other page uses. Starlight
		// has no equivalent "default vs template" split: every route's
		// `<title>` goes through the same `${data.title} ${titleDelimiter}
		// ${siteTitle}` formula (astro.config.mjs sets siteTitle to "docs").
		// Setting this page's own title to the complete string up front, and
		// overriding the generated `<title>` tag below (native `head`
		// frontmatter, not a component override) to that same string,
		// reproduces dump's exact homepage title/og:title without a second
		// "— docs" getting appended on top.
		title: 'docs — technical documentation for things built under raioviajante.',
		description: 'Public technical documentation for projects and systems built under RaioViajante.',
		template: 'splash',
		hero: {},
		pagefind: false,
		head: [
			{
				tag: 'title',
				content: 'docs — technical documentation for things built under raioviajante.',
			},
		],
	}}
>
	<h1 class="sr-only">RaioViajante Docs</h1>

	<div class="home">
		<p class="kicker">docs/</p>
		<p class="tagline">technical documentation for things built under raioviajante.</p>

		<button type="button" class="home-search" id="home-search-trigger">
			<Icon name="magnifier" />
			<span>search docs...</span>
		</button>

		<div class="section">
			<div class="section-label">projects/</div>
			<div class="entries">
				<div class="entry">
					<a class="entry-name" href="https://github.com/RaioViajante/hum">hum</a>
					<p class="entry-desc">terminal music player</p>
				</div>
				<div class="entry">
					<a class="entry-name" href="/projects/sweep/">sweep</a>
					<p class="entry-desc">file organizer for a selected directory</p>
				</div>
			</div>
		</div>

		<div class="section">
			<div class="section-label">raioviajante/</div>
			<div class="entries">
				<div class="entry">
					<a class="entry-name" href="/raioviajante/design-language/">design language</a>
					<p class="entry-desc">shared tokens, typography, restraint</p>
				</div>
				<div class="entry">
					<a class="entry-name" href="/raioviajante/repository-conventions/">repository conventions</a>
					<p class="entry-desc">commits, branches, releases</p>
				</div>
			</div>
		</div>
	</div>
</StarlightPage>

<script>
	// stopPropagation matters here: Search's own "click outside closes the dialog"
	// listener is attached to `window` the instant it opens, inside this same click's
	// bubble phase — without stopping propagation first, this button's own click event
	// keeps bubbling up to window right after and immediately closes the dialog again.
	document.getElementById('home-search-trigger')?.addEventListener('click', (event) => {
		event.stopPropagation();
		document.querySelector<HTMLButtonElement>('button[data-open-modal]')?.click();
	});
</script>

<style>
	.home {
		padding-block: 0.5rem 2rem;
	}

	.kicker {
		font-family: 'IBM Plex Mono', var(--sl-font-system-mono);
		font-size: var(--sl-text-sm);
		color: color-mix(in srgb, var(--rv-fg) 45%, transparent);
		margin: 0 0 0.5rem;
	}

	.tagline {
		font-family: 'Source Serif 4', ui-serif, Georgia, serif;
		font-size: 1.375rem;
		line-height: 1.55;
		color: var(--sl-color-white);
		margin: 0 0 2.5rem;
	}

	.home-search {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		width: 100%;
		padding: 0 0 0.625rem;
		margin-bottom: 3rem;
		border: none;
		border-bottom: 1px solid var(--sl-color-hairline);
		background: none;
		font-family: 'IBM Plex Mono', var(--sl-font-system-mono);
		font-size: 0.8125rem;
		color: color-mix(in srgb, var(--rv-fg) 55%, transparent);
		cursor: pointer;
	}

	.home-search:hover {
		color: var(--sl-color-white);
	}

	.section {
		margin-bottom: 3rem;
	}

	.section:last-child {
		margin-bottom: 0;
	}

	.section-label {
		font-family: 'IBM Plex Mono', var(--sl-font-system-mono);
		font-size: var(--sl-text-sm);
		color: color-mix(in srgb, var(--rv-fg) 45%, transparent);
		margin-bottom: 1.25rem;
	}

	.entries {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.entry-name {
		display: block;
		font-family: 'IBM Plex Mono', var(--sl-font-system-mono);
		font-size: var(--sl-text-base);
		color: var(--sl-color-white);
		text-decoration: none;
	}

	a.entry-name:hover {
		color: var(--rv-accent);
	}

	.entry-desc {
		font-family: 'Source Serif 4', ui-serif, Georgia, serif;
		font-size: var(--sl-text-base);
		color: color-mix(in srgb, var(--rv-fg) 62%, transparent);
		margin: 0.2rem 0 0;
	}
</style>
