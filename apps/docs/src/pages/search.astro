---
import { SearchPage } from "@raioviajante/design/search";
import { copyFor } from "../lib/copy";
import { searchPagePath } from "../lib/docs";
import DocsShell from "../layouts/DocsShell.astro";

const copy = copyFor("en");
---

<DocsShell title={copy.search.title} description={copy.search.description} current={searchPagePath("en")} counterparts={[{ locale: "pt-BR", path: searchPagePath("pt-BR") }]}>
	<SearchPage site="docs" locale="en" suggestions={copy.search.suggestions} />
</DocsShell>
