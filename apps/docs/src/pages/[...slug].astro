---
import { render } from "astro:content";
import { Pager, Prose } from "@raioviajante/design/parts";
import { getSectionHeadings } from "@raioviajante/design/sections";
import { DocHeader } from "../components/DocHeader";
import DocsShell from "../layouts/DocsShell.astro";
import { pageJsonLd } from "../lib/structured-data";
import { editUrl, getPages, labelOf, lastUpdated, navPages, pathOf } from "../lib/docs";
import { breadcrumb } from "../lib/nav";

export async function getStaticPaths() {
	const pages = await getPages();
	return pages.map((entry, index) => ({
		params: { slug: pathOf(entry).slice(1, -1) },
		props: { entry, index },
	}));
}

const { entry, index } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(entry);
const headings = getSectionHeadings(remarkPluginFrontmatter);
const pages = await getPages();
const { data } = entry;
const path = pathOf(entry);

const toc = headings
	.filter((heading) => heading.number !== undefined)
	.map((heading) => ({
		label: heading.text,
		href: `#${heading.slug}`,
		number: heading.number,
	}));

const crumbs = breadcrumb(await navPages(), index, data.group);
const updated = lastUpdated(entry);
const jsonLd = await pageJsonLd(entry);

const neighbor = (page: (typeof pages)[number] | undefined, label: string) =>
	page ? { label, title: labelOf(page), href: pathOf(page) } : undefined;
const previous = index === 0 ? { label: "← Previous", title: "index", href: "/" } : neighbor(pages[index - 1], "← Previous");
const next = neighbor(pages[index + 1], "Next →");
---

<DocsShell title={data.title} description={data.description} current={path} toc={toc} jsonLd={jsonLd}>
	<DocHeader
		crumbs={crumbs}
		title={data.title}
		line={data.tagline ?? data.description}
		status={data.status}
		meta={[...data.meta, ...(updated ? [`updated ${updated}`] : [])]}
		source={data.source}
	/>

	<Prose><Content /></Prose>

	<div class="page-foot">
		{updated && <span>last updated {updated}</span>}
		<a href={editUrl(entry)}>edit this page on GitHub ↗</a>
	</div>
	<Pager prev={previous} next={next} />
</DocsShell>
