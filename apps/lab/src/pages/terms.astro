---
import { DEFAULT_LOCALE } from "../../../../site/locales";
import BaseLayout from "../layouts/BaseLayout.astro";
import { TermsPage } from "../components/LegalPages";
import { textFor } from "../lib/copy";
import { routeCounterparts } from "../lib/routes";
const text = textFor(DEFAULT_LOCALE).legal.terms;
---

<BaseLayout
  pageTitle={text.title}
  description={text.description}
  counterparts={routeCounterparts("terms", DEFAULT_LOCALE)}
>
  <TermsPage locale={DEFAULT_LOCALE} />
</BaseLayout>
