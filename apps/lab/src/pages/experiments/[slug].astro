---
import BootSector from "../../components/surfaces/BootSector.astro";
import ExecutionStates from "../../components/surfaces/ExecutionStates.astro";
import FilenameClassifier from "../../components/surfaces/FilenameClassifier.astro";
import SchedulerSimulator from "../../components/surfaces/SchedulerSimulator.astro";
import type { InferGetStaticPropsType } from "astro";
import ExperimentLayout from "../../layouts/ExperimentLayout.astro";
import { experimentsFor } from "../../data/experiments";

export function getStaticPaths() {
  return experimentsFor("en").map((experiment) => ({
    params: { slug: experiment.slug },
    props: { experiment },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { experiment } = Astro.props as Props;
---

<ExperimentLayout experiment={experiment}>
  {experiment.surface === "filename-classifier" && (
    <FilenameClassifier slot="surface" locale={experiment.locale} />
  )}
  {experiment.surface === "execution-states" && (
    <ExecutionStates slot="surface" locale={experiment.locale} />
  )}
  {experiment.surface === "boot-sector" && (
    <BootSector slot="surface" locale={experiment.locale} />
  )}
  {experiment.surface === "scheduler-simulator" && (
    <SchedulerSimulator slot="surface" locale={experiment.locale} />
  )}
</ExperimentLayout>
