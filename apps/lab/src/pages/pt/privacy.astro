---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PrivacyPage } from "../../components/LegalPages";
import { textFor } from "../../lib/copy";
import { routeCounterparts } from "../../lib/routes";
const text = textFor("pt-BR").legal.privacy;
---

<BaseLayout
  locale="pt-BR"
  pageTitle={text.title}
  description={text.description}
  counterparts={routeCounterparts("privacy", "pt-BR")}
>
  <PrivacyPage locale="pt-BR" />
</BaseLayout>
