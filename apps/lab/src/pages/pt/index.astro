---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LabIndex } from "../../components/LabIndex";
import { websiteJsonLd } from "../../../../../seo/structured-data";
import { origin } from "../../lib/seo";
import { routeCounterparts } from "../../lib/routes";
import { copy } from "../../lib/copy";
---

<BaseLayout
  locale="pt-BR"
  counterparts={routeCounterparts("home", "pt-BR")}
  jsonLd={[
    // One stable WebSite node per host: the same English description and
    // shipped-language set on every page that emits it.
    websiteJsonLd(origin, "lab", copy.en.description, {
      languages: ["en", "pt-BR"],
    }),
  ]}
>
  <LabIndex locale="pt-BR" />
</BaseLayout>
<script>
  import { startExperimentFilter } from "../../lib/filter";
  startExperimentFilter();
</script>
