---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SearchPage } from "@raioviajante/design/search";
import { portugueseExperiments } from "../../data/experiments";
const terms = [
  ...new Set(
    portugueseExperiments.flatMap(({ title, project }) => [title, project]),
  ),
];
---

<BaseLayout
  locale="pt-BR"
  pageTitle="busca"
  description="Busque experimentos do Lab e nos sites do RaioViajante."
  counterparts={[{ locale: "en", path: "/search/" }]}
>
  <SearchPage
    site="lab"
    locale="pt-BR"
    suggestions={{ site: terms, everywhere: terms }}
  />
</BaseLayout>
