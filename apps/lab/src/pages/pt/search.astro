---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SearchPage } from "@raioviajante/design/search";
import { textFor } from "../../lib/copy";
import { routeCounterparts } from "../../lib/routes";
import { searchSuggestions } from "../../lib/search";
const text = textFor("pt-BR");
---

<BaseLayout
  locale="pt-BR"
  pageTitle={text.search.title}
  description={text.search.description}
  counterparts={routeCounterparts("search", "pt-BR")}
>
  <SearchPage
    site="lab"
    locale="pt-BR"
    suggestions={searchSuggestions["pt-BR"]}
  />
</BaseLayout>
