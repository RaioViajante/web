---
import BaseLayout from "../layouts/BaseLayout.astro";
import { websiteJsonLd } from "../../../../seo/structured-data";
import { LabIndex } from "../components/LabIndex";
import { origin } from "../lib/seo";
import { routeCounterparts } from "../lib/routes";
import { copy } from "../lib/copy";
---

<BaseLayout
  counterparts={routeCounterparts("home", "en")}
  jsonLd={[
    websiteJsonLd(origin, "lab", copy.en.description, {
      languages: ["en", "pt-BR"],
    }),
  ]}
>
  <LabIndex />
</BaseLayout>
<script>
  import { startExperimentFilter } from "../lib/filter";
  startExperimentFilter();
</script>
