---
import "@raioviajante/design/tokens.css";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { formatTitle } from "../lib/site";

interface Props {
  pageTitle?: string;
  description?: string;
}

const { pageTitle, description = "lab.raioviajante.com — things may break." } =
  Astro.props;

const title = formatTitle(pageTitle);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico?v=3" sizes="any" />
    <link rel="icon" type="image/png" href="/icon.png?v=3" sizes="512x512" />
    <link
      rel="apple-touch-icon"
      href="/apple-touch-icon.png?v=3"
      sizes="180x180"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap"
    />

    <title>{title}</title>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
