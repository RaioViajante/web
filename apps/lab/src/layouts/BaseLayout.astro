---
import "@fontsource-variable/noto-sans-mono";
import "@raioviajante/design/styles.css";
import "../styles/lab.css";
import { LabFrame } from "../components/LabFrame";
import { formatTitle } from "../lib/site";
interface Props {
  pageTitle?: string;
  description?: string;
  current?: string;
}
const {
  pageTitle,
  description = "lab.raioviajante.com — things may break.",
  current = Astro.url.pathname,
} = Astro.props;
const title = formatTitle(pageTitle);
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico?v=3" sizes="any" />
    <link rel="icon" type="image/png" href="/icon.png?v=3" sizes="512x512" />
    <link
      rel="apple-touch-icon"
      href="/apple-touch-icon.png?v=3"
      sizes="180x180"
    />
    <title>{title}</title>
  </head>
  <body>
    <LabFrame current={current}>
      <slot />
    </LabFrame>
    <script>
      import { startBehavior } from "@raioviajante/design/behavior";
      startBehavior();
    </script>
  </body>
</html>
