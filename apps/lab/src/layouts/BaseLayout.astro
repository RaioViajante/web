---
import { isNotFoundPath } from "../../../../seo/metadata";
import SeoHead from "../../../../seo/SeoHead.astro";
import { jsonLdScript } from "../../../../seo/structured-data";
import { themeColor } from "@raioviajante/design/theme-color";
import fontUrl from "@raioviajante/design/fonts/NotoSansMono-Latin-Variable.woff2?url";
import "@raioviajante/design/fonts.css";
import "@raioviajante/design/styles.css";
import "../styles/lab.css";
import { LabFrame } from "../components/LabFrame";
import { formatTitle } from "../lib/site";
interface Props {
  pageTitle?: string;
  description?: string;
  current?: string;
  /** Structured data nodes for this page. */
  jsonLd?: object[];
}
const {
  pageTitle,
  description = "lab.raioviajante.com — things may break.",
  current = Astro.url.pathname,
  jsonLd,
} = Astro.props;
const color = await themeColor();
const title = formatTitle(pageTitle);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link
      rel="preload"
      href={fontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <SeoHead
      origin={Astro.site!.href}
      site="lab"
      path={Astro.url.pathname}
      title={title}
      description={description}
      noindex={isNotFoundPath(Astro.url.pathname)}
      themeColor={color}
    />
    {jsonLd && (
      <script
        is:inline
        type="application/ld+json"
        set:html={jsonLdScript(...jsonLd)}
      ></script>
    )}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico?v=4" sizes="any" />
    <link rel="icon" type="image/png" href="/icon.png?v=4" sizes="512x512" />
    <link
      rel="apple-touch-icon"
      href="/apple-touch-icon.png?v=4"
      sizes="180x180"
    />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{title}</title>
  </head>
  <body>
    <LabFrame current={current}>
      <slot />
    </LabFrame>
    <script>
      import { startBehavior } from "@raioviajante/design/behavior";
      startBehavior();
    </script>
  </body>
</html>
