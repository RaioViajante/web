---
import BaseLayout from "./BaseLayout.astro";
import { Section } from "@raioviajante/design/parts";
import {
  ExperimentHeader,
  Fidelity,
  ExperimentRelated,
  ExperimentPager,
} from "../components/ExperimentParts";
import type { Experiment } from "../data/experiments";
interface Props {
  experiment: Experiment;
}
const { experiment } = Astro.props;
---

<BaseLayout pageTitle={experiment.title} description={experiment.description}>
  <ExperimentHeader experiment={experiment} />
  <Section number="01." title="Question">
    <p>{experiment.what}</p>
  </Section>
  <Section number="02." title="Bench">
    <slot name="surface" />
  </Section>
  <Section number="03." title="Fidelity">
    <Fidelity experiment={experiment} />
  </Section>
  <Section number="04." title="Related">
    <ExperimentRelated experiment={experiment} />
  </Section>
  <ExperimentPager experiment={experiment} />
</BaseLayout>
