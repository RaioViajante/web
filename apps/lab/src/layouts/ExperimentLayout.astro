---
import BaseLayout from "./BaseLayout.astro";
import { Section } from "@raioviajante/design/parts";
import {
  ExperimentHeader,
  Fidelity,
  ExperimentRelated,
  ExperimentPager,
} from "../components/ExperimentParts";
import type { Experiment } from "../data/experiments";
import { counterpartsOf } from "../data/experiments";
import { textFor } from "../lib/copy";
interface Props {
  experiment: Experiment;
}
const { experiment } = Astro.props;
const text = textFor(experiment.locale);
---

<BaseLayout
  pageTitle={experiment.title}
  description={experiment.description}
  locale={experiment.locale}
  counterparts={counterpartsOf(experiment)}
>
  <ExperimentHeader experiment={experiment} />
  <Section number="01." title={text.question}>
    <p>{experiment.what}</p>
  </Section>
  <Section number="02." title={text.bench}>
    <slot name="surface" />
  </Section>
  <Section number="03." title={text.fidelity}>
    <Fidelity experiment={experiment} />
    {experiment.locale === "pt-BR" && experiment.notes && (
      <p>{experiment.notes}</p>
    )}
  </Section>
  <Section number="04." title={text.related}>
    <ExperimentRelated experiment={experiment} />
  </Section>
  <ExperimentPager experiment={experiment} />
</BaseLayout>
