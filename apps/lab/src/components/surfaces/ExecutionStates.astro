---
import { ExecutionBench } from "./ExecutionBench";
---

<ExecutionBench />
<script>
  import {
    newExecution,
    transition,
    type Operation,
  } from "../../lib/execution-states";
  import { playSound } from "@raioviajante/design/sound";
  const container = document.querySelector<HTMLElement>("[data-execution]");
  if (container) {
    let state = newExecution();
    const feedback = container.querySelector<HTMLElement>("[data-feedback]")!;
    const history =
      container.querySelector<HTMLOListElement>("[data-history]")!;
    const code = container.querySelector<HTMLInputElement>("#exit-code")!;
    const message =
      container.querySelector<HTMLInputElement>("#failure-message")!;
    function render() {
      const accepted: string[] = [];
      const rejected: string[] = [];
      container!
        .querySelectorAll<HTMLButtonElement>("[data-operation]")
        .forEach((button) => {
          const action = button.dataset.operation!;
          const allowed =
            action === "start"
              ? state.status === "QUEUED"
              : action === "cancel"
                ? ["QUEUED", "RUNNING"].includes(state.status)
                : state.status === "RUNNING";
          button.classList.toggle("rv-btn--rejected", !allowed);
          button.classList.toggle(
            "rv-btn--primary",
            action === "start" && allowed,
          );
          button.setAttribute("aria-disabled", String(!allowed));
          (allowed ? accepted : rejected).push(action);
          container!
            .querySelector(`[data-rule="${action}"]`)!
            .classList.toggle("is-available", allowed);
        });
      container!.querySelector("[data-availability]")!.textContent =
        `Accepted now: ${accepted.join(", ") || "none"}. Rejected now: ${rejected.join(", ") || "none"}.`;
      container!.querySelectorAll<HTMLElement>(".rv-state").forEach((mark) => {
        const current = mark.textContent === state.status;
        mark.classList.toggle("rv-state--current", current);
        if (current) mark.setAttribute("aria-current", "true");
        else mark.removeAttribute("aria-current");
      });
      container!
        .querySelectorAll<HTMLElement>("[data-field]")
        .forEach((field) => {
          const value = state[field.dataset.field as keyof typeof state];
          field.textContent = value === null ? "—" : String(value);
        });
    }
    function record(text: string) {
      const item = document.createElement("li");
      item.textContent = text;
      history.append(item);
    }
    container
      .querySelectorAll<HTMLButtonElement>("[data-operation]")
      .forEach((button) => {
        button.addEventListener("click", () => {
          const operation = button.dataset.operation as Operation;
          try {
            if (
              state.status === "RUNNING" &&
              (operation === "succeed" || operation === "fail") &&
              !code.checkValidity()
            ) {
              throw new Error(
                "Enter an integer exit code between -2147483648 and 2147483647 for this example",
              );
            }
            state = transition(
              state,
              operation,
              code.valueAsNumber,
              message.value,
              new Date().toISOString(),
            );
            render();
            feedback.textContent = `${operation} accepted → ${state.status}.`;
            record(`accepted: ${operation} → ${state.status}`);
            playSound("success");
          } catch (error) {
            const reason =
              error instanceof Error ? error.message : "Operation rejected";
            feedback.textContent = `${operation} rejected: ${reason}. State remains ${state.status}.`;
            record(`rejected: ${operation} from ${state.status}: ${reason}`);
            playSound("reject");
          }
        });
      });
    container
      .querySelector<HTMLButtonElement>("[data-new]")!
      .addEventListener("click", () => {
        playSound("success");
        state = newExecution();
        code.value = "0";
        message.value = "Example failure";
        history.replaceChildren();
        record("created → QUEUED");
        render();
        feedback.textContent =
          "New sample execution created in QUEUED. This is not a lifecycle transition.";
      });
  }
</script>
