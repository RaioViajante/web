---
import { ExecutionBench } from "./ExecutionBench";
import type { LocaleId } from "../../../../../site/locales";
interface Props {
  locale: LocaleId;
}
const { locale } = Astro.props;
---

<ExecutionBench locale={locale} />
<script>
  import {
    ExecutionRejection,
    isAllowed,
    newExecution,
    transition,
    type Operation,
  } from "../../lib/execution-states";
  import { availabilityText } from "../../lib/execution-view";
  import type { ExecutionCopy } from "../../lib/bench-copy";
  import { fill } from "../../lib/template";
  import { playSound } from "@raioviajante/design/sound";
  const container = document.querySelector<HTMLElement>("[data-execution]");
  if (container) {
    // Rendered into the page at build time; never read from the browser.
    const text = JSON.parse(container.dataset.copy!) as Pick<
      ExecutionCopy,
      | "operations"
      | "availability"
      | "none"
      | "defaultFailureMessage"
      | "messages"
      | "reasons"
    >;
    let state = newExecution();
    const feedback = container.querySelector<HTMLElement>("[data-feedback]")!;
    const history =
      container.querySelector<HTMLOListElement>("[data-history]")!;
    const code = container.querySelector<HTMLInputElement>("#exit-code")!;
    const message =
      container.querySelector<HTMLInputElement>("#failure-message")!;
    function render() {
      container!
        .querySelectorAll<HTMLButtonElement>("[data-operation]")
        .forEach((button) => {
          const action = button.dataset.operation as Operation;
          const allowed = isAllowed(state.status, action);
          button.classList.toggle("rv-btn--rejected", !allowed);
          button.classList.toggle(
            "rv-btn--primary",
            action === "start" && allowed,
          );
          button.setAttribute("aria-disabled", String(!allowed));
          container!
            .querySelector(`[data-rule="${action}"]`)!
            .classList.toggle("is-available", allowed);
        });
      container!.querySelector("[data-availability]")!.textContent =
        availabilityText(text, state.status);
      container!.querySelectorAll<HTMLElement>(".rv-state").forEach((mark) => {
        const current = mark.textContent === state.status;
        mark.classList.toggle("rv-state--current", current);
        if (current) mark.setAttribute("aria-current", "true");
        else mark.removeAttribute("aria-current");
      });
      container!
        .querySelectorAll<HTMLElement>("[data-field]")
        .forEach((field) => {
          const value = state[field.dataset.field as keyof typeof state];
          field.textContent = value === null ? "—" : String(value);
        });
    }
    function record(line: string) {
      const item = document.createElement("li");
      item.textContent = line;
      history.append(item);
    }
    container
      .querySelectorAll<HTMLButtonElement>("[data-operation]")
      .forEach((button) => {
        button.addEventListener("click", () => {
          const operation = button.dataset.operation as Operation;
          const label = text.operations[operation];
          try {
            if (
              state.status === "RUNNING" &&
              (operation === "succeed" || operation === "fail") &&
              !code.checkValidity()
            ) {
              throw new RangeError(text.reasons["exit-code-range"]);
            }
            state = transition(
              state,
              operation,
              code.valueAsNumber,
              message.value,
              new Date().toISOString(),
            );
            render();
            feedback.textContent = fill(text.messages.accepted, {
              operation: label,
              status: state.status,
            });
            record(
              fill(text.messages.historyAccepted, {
                operation: label,
                status: state.status,
              }),
            );
            playSound("success");
          } catch (error) {
            const reason =
              error instanceof ExecutionRejection
                ? text.reasons[error.code]
                : error instanceof Error
                  ? error.message
                  : String(error);
            feedback.textContent = fill(text.messages.rejected, {
              operation: label,
              reason,
              status: state.status,
            });
            record(
              fill(text.messages.historyRejected, {
                operation: label,
                status: state.status,
                reason,
              }),
            );
            playSound("reject");
          }
        });
      });
    container
      .querySelector<HTMLButtonElement>("[data-new]")!
      .addEventListener("click", () => {
        playSound("success");
        state = newExecution();
        code.value = "0";
        message.value = text.defaultFailureMessage;
        history.replaceChildren();
        record(text.messages.created);
        render();
        feedback.textContent = text.messages.newExample;
      });
  }
</script>
