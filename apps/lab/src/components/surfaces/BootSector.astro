---
import { highlightBlock } from "@raioviajante/design/components";
import { sectionsFor } from "../../data/boot-sector";
import { bootCopy } from "../../lib/bench-copy";
import { BootBench } from "./BootBench";
import type { LocaleId } from "../../../../../site/locales";
interface Props {
  locale: LocaleId;
}
const { locale } = Astro.props;
const models = await Promise.all(
  sectionsFor(locale).map((section) =>
    highlightBlock({
      code: section.code,
      lang: "asm",
      meta: "showLineNumbers expanded",
    }),
  ),
);
const output = await highlightBlock({
  code: "Hello, World!",
  lang: "text",
  meta: `title="${bootCopy[locale].resultTitle}"`,
});
---

<BootBench locale={locale} models={models} output={output} />
<script>
  import { playSound } from "@raioviajante/design/sound";
  import { fill } from "../../lib/template";
  const container = document.querySelector<HTMLElement>("[data-boot]")!;
  // Rendered into the page at build time; never read from the browser.
  const text = JSON.parse(container.dataset.copy!) as {
    progress: string;
    rejectedPrevious: string;
    rejectedNext: string;
  };
  const buttons = [
    ...container.querySelectorAll<HTMLButtonElement>("[data-section]"),
  ];
  const panels = [...container.querySelectorAll<HTMLElement>("[data-panel]")];
  const previous = container.querySelector<HTMLButtonElement>("[data-prev]")!;
  const next = container.querySelector<HTMLButtonElement>("[data-next]")!;
  const progress = container.querySelector("[data-progress]")!;
  let index = 0;
  function show(target: number, sound = true) {
    if (target < 0 || target >= buttons.length) {
      progress.textContent = fill(
        target < 0 ? text.rejectedPrevious : text.rejectedNext,
        { number: index + 1, total: buttons.length },
      );
      playSound("reject");
      return;
    }
    index = target;
    buttons.forEach((button, number) =>
      button.setAttribute("aria-pressed", String(number === index)),
    );
    panels.forEach((panel, number) => (panel.hidden = number !== index));
    progress.textContent = fill(text.progress, {
      number: index + 1,
      total: buttons.length,
      title: buttons[index].dataset.title!,
    });
    [previous, next].forEach((button, number) => {
      const rejected =
        number === 0 ? index === 0 : index === buttons.length - 1;
      button.classList.toggle("rv-btn--rejected", rejected);
      button.setAttribute("aria-disabled", String(rejected));
    });
    if (sound) playSound("success");
  }
  buttons.forEach((button, number) => {
    button.addEventListener("click", () => show(number, false));
    button.addEventListener("keydown", (event) => {
      const target =
        event.key === "ArrowRight"
          ? (index + 1) % buttons.length
          : event.key === "ArrowLeft"
            ? (index + buttons.length - 1) % buttons.length
            : event.key === "Home"
              ? 0
              : event.key === "End"
                ? buttons.length - 1
                : undefined;
      if (target === undefined) return;
      event.preventDefault();
      show(target);
      buttons[target].focus();
    });
  });
  previous.addEventListener("click", () => show(index - 1));
  next.addEventListener("click", () => show(index + 1));
</script>
