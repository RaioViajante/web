---
import { highlightBlock } from "@raioviajante/design/components";
import { sections } from "../../data/boot-sector";
import { BootBench } from "./BootBench";
const models = await Promise.all(
  sections.map((section) =>
    highlightBlock({
      code: section.code,
      lang: "asm",
      meta: "showLineNumbers expanded",
    }),
  ),
);
const output = await highlightBlock({
  code: "Hello, World!",
  lang: "text",
  meta: 'title="documented result · qemu"',
});
---

<BootBench models={models} output={output} />
<script>
  import { playSound } from "@raioviajante/design/sound";
  const container = document.querySelector<HTMLElement>("[data-boot]")!;
  const buttons = [
    ...container.querySelectorAll<HTMLButtonElement>("[data-section]"),
  ];
  const panels = [...container.querySelectorAll<HTMLElement>("[data-panel]")];
  const previous = container.querySelector<HTMLButtonElement>("[data-prev]")!;
  const next = container.querySelector<HTMLButtonElement>("[data-next]")!;
  let index = 0;
  function show(target: number, sound = true) {
    if (target < 0 || target >= buttons.length) {
      container.querySelector("[data-progress]")!.textContent =
        `rejected: no ${target < 0 ? "previous" : "next"} section · ${index + 1} / ${buttons.length}`;
      playSound("reject");
      return;
    }
    index = target;
    buttons.forEach((button, number) =>
      button.setAttribute("aria-pressed", String(number === index)),
    );
    panels.forEach((panel, number) => (panel.hidden = number !== index));
    container.querySelector("[data-progress]")!.textContent =
      `${index + 1} / ${buttons.length} · ${buttons[index].textContent!.slice(3)}`;
    [previous, next].forEach((button, number) => {
      const rejected =
        number === 0 ? index === 0 : index === buttons.length - 1;
      button.classList.toggle("rv-btn--rejected", rejected);
      button.setAttribute("aria-disabled", String(rejected));
    });
    if (sound) playSound("success");
  }
  buttons.forEach((button, number) => {
    button.addEventListener("click", () => show(number, false));
    button.addEventListener("keydown", (event) => {
      const target =
        event.key === "ArrowRight"
          ? (index + 1) % buttons.length
          : event.key === "ArrowLeft"
            ? (index + buttons.length - 1) % buttons.length
            : event.key === "Home"
              ? 0
              : event.key === "End"
                ? buttons.length - 1
                : undefined;
      if (target === undefined) return;
      event.preventDefault();
      show(target);
      buttons[target].focus();
    });
  });
  previous.addEventListener("click", () => show(index - 1));
  next.addEventListener("click", () => show(index + 1));
</script>
