---
import { ClassifierBench } from "./ClassifierBench";
import type { LocaleId } from "../../../../../site/locales";
interface Props {
  locale: LocaleId;
}
const { locale } = Astro.props;
---

<ClassifierBench locale={locale} />
<script>
  import { classifyFilename } from "../../lib/filename-classifier";
  import {
    categoryParts,
    emptyCounts,
    summaryParts,
    type TextPart,
  } from "../../lib/classifier-view";
  import type { ClassifierCategory } from "../../lib/bench-copy";
  import type { PluralForms } from "../../lib/plural-core";
  import { playSound } from "@raioviajante/design/sound";
  const container = document.querySelector<HTMLElement>("[data-classifier]")!;
  // Rendered into the page at build time; never read from the browser.
  const text = JSON.parse(container.dataset.copy!) as {
    intlLocale: string;
    none: string;
    categoryGloss: Record<ClassifierCategory, string | null>;
    categoryLang: string | null;
    summary: PluralForms;
  };
  const names = container.querySelector<HTMLTextAreaElement>("#filenames")!;
  const directory = container.querySelector<HTMLInputElement>("#directory")!;
  const body = container.querySelector("tbody")!;
  const summary = container.querySelector("[data-summary]")!;
  const initial = names.value;
  function nodes(parts: TextPart[]): Node[] {
    return parts.map((part) => {
      if (!part.lang) return document.createTextNode(part.text);
      const span = document.createElement("span");
      span.lang = part.lang;
      span.textContent = part.text;
      return span;
    });
  }
  function render(sound = false) {
    const results = names.value
      .split(/\r?\n/)
      .filter((name) => name.length > 0)
      .map(classifyFilename);
    const counts = emptyCounts();
    const dir = directory.value.replace(/\/+$/, "");
    body.replaceChildren(
      ...results.map((row) => {
        const category = row.category as ClassifierCategory;
        counts[category]++;
        const tr = document.createElement("tr");
        [
          [{ text: row.filename }],
          [{ text: row.suffix || text.none }],
          categoryParts(
            category,
            text.categoryGloss[category],
            text.categoryLang ?? undefined,
          ),
          [{ text: `${dir}/${row.category}/${row.filename}` }],
        ].forEach((parts, index) => {
          const cell = document.createElement(index === 0 ? "th" : "td");
          if (index === 0) cell.setAttribute("scope", "row");
          cell.className = ["tok-string", "tok-number", "tok-type", ""][index];
          cell.replaceChildren(...nodes(parts));
          tr.append(cell);
        });
        return tr;
      }),
    );
    summary.replaceChildren(
      ...nodes(
        summaryParts(
          text.intlLocale,
          results.length,
          counts,
          text.summary,
          text.categoryLang ?? undefined,
        ),
      ),
    );
    if (sound) playSound("success");
  }
  [names, directory].forEach((input) => {
    input.addEventListener("input", () => render());
    input.addEventListener("change", () => playSound("success"));
  });
  container
    .querySelector("[data-classify]")!
    .addEventListener("click", () => render(true));
  container.querySelector("[data-reset]")!.addEventListener("click", () => {
    names.value = initial;
    directory.value = "~/Downloads";
    render(true);
  });
  container
    .querySelectorAll<HTMLButtonElement>("[data-sample]")
    .forEach((button) =>
      button.addEventListener("click", () => {
        names.value += `${names.value && !names.value.endsWith("\n") ? "\n" : ""}${button.dataset.sample}`;
        render(true);
      }),
    );
</script>
